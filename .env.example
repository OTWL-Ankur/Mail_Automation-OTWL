NODE_ENV=development
PORT=3000

# Must match the mailbox used during OAuth authorization
GMAIL_MAILBOX=ankur@oceantransworld.com
GMAIL_POLL_INTERVAL_MS=60000
# false = start from now and do not import old messages on first run
GMAIL_IMPORT_EXISTING=false
MAX_ATTACHMENT_MB=25

# PostgreSQL. Set DATABASE_URL instead if you use a connection string.
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=MailToJob
DB_USER=app_user
DB_PASSWORD=replace_me
DB_SSL=false
DB_POOL_MAX=10

# Files are stored under this directory. Use an absolute path in production.
STORAGE_ROOT=./storage

# Local OAuth files; do not commit them.
GOOGLE_CREDENTIALS_PATH=./credentials.json
GOOGLE_TOKEN_PATH=./token.json
